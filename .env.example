# Required for persistent accounts, sessions, and per-user vault data.
# Use a PostgreSQL connection string from Neon or another compatible provider.
DATABASE_URL=
# Optional: enables the AI concierge, tagging, story, and transcription APIs.
GEMINI_API_KEY=

# Optional: defaults to the current stable production model.
GEMINI_MODEL=gemini-3.6-flash

# Arweave wallet keys are connected per browser tab and are never stored as
# server environment variables.
