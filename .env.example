# Optional: enables the AI concierge, tagging, story, and transcription APIs.
GEMINI_API_KEY=

# Optional: defaults to the current stable production model.
GEMINI_MODEL=gemini-3.6-flash

# Optional server-managed wallet. Prefer connecting a browser-session JWK instead.
# Never commit a real key. Supply it only through the production secret manager.
ARWEAVE_JWK=
