{
  "name": "aeterna-vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/patch-vinext-worker.mjs && mkdir -p dist/.openai && cp .openai/hosting.json dist/.openai/hosting.json",
    "start": "vinext start",
    "clean": "rm -rf dist .vinext .vite",
    "lint": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:unit && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-rsc": "^0.5.30",
    "arweave": "^1.15.7",
    "d3": "^7.9.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^3.10.1",
    "vinext": "^0.2.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
}
