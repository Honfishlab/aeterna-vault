{
  "rules": [
    {
      "id": "aeterna-vault-browser-uploads",
      "allowed": {
        "origins": [
          "https://aeterna-vault-zawj.onrender.com",
          "http://localhost:3000"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "content-type"
        ]
      },
      "exposeHeaders": [
        "etag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
